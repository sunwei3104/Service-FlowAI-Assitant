{
  "name": "@serviceflow/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared components for apps/web + apps/console: shadcn/ui primitives (components/ui) and ServiceFlow components (plan §21.6)",
  "exports": {
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./ui/*": "./src/components/ui/*.tsx",
    "./states": "./src/components/states/index.ts",
    "./feedback/*": "./src/components/feedback/*.tsx",
    "./shell": "./src/components/shell/index.ts",
    "./icons": "./src/components/icons/index.tsx",
    "./display/*": "./src/components/display/*.tsx",
    "./data/*": "./src/components/data/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ui:add": "node scripts/ui-add.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@serviceflow/ui-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
