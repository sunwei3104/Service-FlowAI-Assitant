# apps/web — copy to .env.local (never commit real values)

# local | staging | production (plan appendix A). Mocking is refused when production.
APP_ENV=local

# Same-origin API base path (plan §7.2)
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# enabled  = use src/mocks (MSW) — no backend needed (frontend-first phase)
# disabled = call services/api for real
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_MOCK_TENANT=smartvend

# Local dev only, when Caddy is not in front: proxy /api/* to the Go API
# API_ORIGIN=http://localhost:8080
