# apps/console — copy to .env.local (never commit real values)

# local skips the Cloudflare Access check (plan §5.2 dev identity). Anything else REQUIRES the CF_ACCESS_* values.
APP_ENV=local

NEXT_PUBLIC_API_BASE_PATH=/console/v1
NEXT_PUBLIC_API_MOCKING=enabled

# Cloudflare Access (plan §22.3, appendix A) — required when APP_ENV != local
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<application audience tag>

# Local dev only, when Caddy is not in front:
# API_ORIGIN=http://localhost:8080
